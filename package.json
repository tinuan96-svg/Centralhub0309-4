{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-dev.mjs",
    "postinstall": "node scripts/patch-next.mjs",
    "build": "next build",
    "build:mobile": "set NEXT_OUTPUT=export && next build && npx cap sync android",
    "start": "next start",
    "lint": "eslint .",
    "audit:routes": "node scripts/route-audit.mjs",
    "audit:features": "node scripts/feature-continuity-audit.mjs",
    "audit:smoke": "node scripts/route-smoke.mjs",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "validate:production": "npm run lint && npm run audit:routes && npm run audit:features && npx tsc --noEmit && npm run build && npm run audit:smoke"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.15",
    "eslint": "^9.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.34.0",
    "next": "16.3.4",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "3.3.3",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/node": "20.11.0",
    "eslint-config-next": "16.3.4",
    "typescript": "5.3.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
