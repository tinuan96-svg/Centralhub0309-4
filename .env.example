# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI (Required for AI features)
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key

# Twilio (Optional - for legacy messaging)
NEXT_PUBLIC_TWILIO_ACCOUNT_SID=your_twilio_account_sid
NEXT_PUBLIC_TWILIO_AUTH_TOKEN=your_twilio_auth_token
NEXT_PUBLIC_TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Meta WhatsApp
WHATSAPP_VERIFY_TOKEN=your_secure_verify_token_here

# Marketing runtime (Edge Function secrets only - NEVER expose in NEXT_PUBLIC_* variables)
# MARKETING_APP_URL is the private/admin application return URL after OAuth.
MARKETING_APP_URL=https://your-admin-domain
# Base64 encoding of exactly 32 random bytes for AES-256-GCM token/credential encryption.
MARKETING_TOKEN_ENCRYPTION_KEY=base64_32_byte_secret

# IMPORTANT:
# Provider App IDs/Secrets are NOT global environment variables.
# They are configured per store in marketing_provider_configs and encrypted server-side.
# Each store should use its own platform developer application/identity where provider policy/branding requires it.

# Tax filing sandbox integration (server-only: NEVER use NEXT_PUBLIC_* or commit real values)
# VAT (MTD) REST application test: HMRC sandbox app must be subscribed to Hello World and VAT (MTD).
HMRC_VAT_SANDBOX_CLIENT_ID=
HMRC_VAT_SANDBOX_CLIENT_SECRET=
# Future VAT customer OAuth redirect; no delegated VAT access flow is enabled yet.
# HMRC_VAT_SANDBOX_REDIRECT_URI=https://centralhub.network/api/finance/hmrc-vat/callback

# PAYE RTI and Corporation Tax filing use separate HMRC XML test services, NOT REST sandbox.
# Obtain approved XML test credentials/specifications and a vendor ID from HMRC SDS.
HMRC_PAYE_TEST_VENDOR_ID=
HMRC_PAYE_XML_TEST_SENDER_ID=
HMRC_PAYE_XML_TEST_PASSWORD=
HMRC_CT_TEST_VENDOR_ID=
HMRC_CT_XML_TEST_SENDER_ID=
HMRC_CT_XML_TEST_PASSWORD=

# Companies House test application, test web OAuth client, sandbox company and test API key.
CH_SANDBOX_CLIENT_ID=
CH_SANDBOX_CLIENT_SECRET=
CH_SANDBOX_API_KEY=
CH_SANDBOX_COMPANY_NUMBER=
