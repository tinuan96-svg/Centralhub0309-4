{
  "name": "centralhub-windows",
  "version": "1.0.0",
  "private": true,
  "description": "CentralHub Windows x64 desktop application",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win:installer": "electron-builder --win nsis --x64 --config.directories.output=dist/installer",
    "dist:win:portable": "electron-builder --win portable --x64 --config.directories.output=dist/portable",
    "dist:win": "npm run dist:win:installer && npm run dist:win:portable"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.centralhub.network.windows",
    "productName": "CentralHub",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CentralHub-Windows-x64-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CentralHub"
    }
  },
  "author": "CentralHub"
}
